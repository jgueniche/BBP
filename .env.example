# Supabase (project in eu-west-3 / Paris)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — Gemini Flash is the default for extraction (ADR-010),
# Anthropic is the automatic fallback when only its key is set.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Meta oEmbed app token for Instagram recipe import ("app_id|app_secret").
# Optional: without it Instagram falls back to paste-the-caption.
INSTAGRAM_OEMBED_TOKEN=

# OpenFoodFacts (identify the app politely)
OPENFOODFACTS_USER_AGENT="BBP/0.1 (contact@bbp.example)"

# Email (Resend, EU)
RESEND_API_KEY=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Stripe (session 15 — BBP Club)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Vercel Cron protection (weekly adaptive TDEE job)
CRON_SECRET=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Feature flags & constants
FEATURE_VIDEO_TRANSCRIPTION=false
COACH_NAME=Kémia
