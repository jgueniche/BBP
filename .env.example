# Supabase (project in eu-west-3 / Paris)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — Gemini Flash is the default for extraction (ADR-010),
# Anthropic is the automatic fallback when only its key is set.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# YouTube Data API v3 key (server only): reads a video's description for
# the recipe import (1 unit per video, 10 000 free units a day). Optional:
# without it the member pastes the description.
YOUTUBE_API_KEY=

# OpenFoodFacts (identify the app politely)
OPENFOODFACTS_USER_AGENT="CopineEnCuisine/0.1 (contact@copine-en-cuisine.example)"

# Email (Resend, EU)
RESEND_API_KEY=

# Web Push (generate once with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@copine-en-cuisine.example

# Observability
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Stripe (abonnement, session production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Vercel Cron protection (no cron scheduled since the pivot; kept for future jobs)
CRON_SECRET=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Feature flags & constants
FEATURE_VIDEO_TRANSCRIPTION=false

# Public origin used for absolute URLs (sitemap, JSON-LD, Open Graph).
# Optional: Vercel's VERCEL_PROJECT_PRODUCTION_URL is used when unset.
NEXT_PUBLIC_SITE_URL=
